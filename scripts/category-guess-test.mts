/**
 * 카테고리 추측 검증 — 카테고리 전 범위 + 겹치는 낱말(오일·마스크·매트·사료…)을 함께 본다.
 * 한 사례만 맞추는 게 아니라 11개 카테고리가 고루 잡히는지, 함정에서 안 틀리는지를 확인.
 *   npx tsx scripts/category-guess-test.mts
 */
import { guessCategory } from '../lib/categoryGuess';

const CASES: Array<[string, string | null]> = [
  // 실제 테스트 상품들
  ['LEAFGREEN 시카 토너 250ml', '화장품'],
  ['제주 접짝뼈국 밀키트 800g', '식품'],
  ['오버핏 울 니트 가디건', '패션'],
  ['아쿠아리프 수분 세럼 30ml', '화장품'],
  ['클리어베일 클렌징폼 150ml', '화장품'],
  ['리커버핏 마사지건 프로', '건강'],
  ['순살 은갈치 구이용 1kg', '식품'],

  // 카테고리별 기본
  ['멀티비타민 60정 3개월분', '건강'],
  ['무선 로봇청소기 3000pa', '가전'],
  ['원목 3단 수납장 화이트', '생활'],
  ['요가매트 10mm 논슬립', '스포츠'],
  ['차량용 무선 충전 거치대', '자동차'],
  ['블랙박스 2채널 QHD', '자동차'],
  ['신생아 기저귀 대형 100매', '유아'],
  ['국내산 닭가슴살 소시지', '식품'],

  // ⚠️함정 — 낱말이 겹치는 것들
  ['강아지 사료 연어맛 2kg', '반려동물'],   // 사료가 식품으로 새면 안 됨
  ['강아지 샴푸 저자극', '반려동물'],       // 샴푸 → 화장품 아님
  ['고양이 간식 츄르 30개', '반려동물'],
  ['아기 로션 무향 200ml', '유아'],         // 로션 → 화장품 아님
  ['아기 물티슈 100매', '유아'],            // 물티슈 → 생활 아님
  ['유아 카시트 신생아용', '유아'],
  ['클렌징오일 딥클렌징', '화장품'],         // 오일 → 식품 아님
  ['프리미엄 참기름 320ml', '식품'],
  ['차량용 방향제 우드향', '자동차'],        // 방향제 → 생활 아님
  ['KF94 마스크 대형 50매', '건강'],
  ['시트마스크 10매 수분', '화장품'],
  ['스마트워치 심박 측정', '가전'],
  ['손목시계 가죽 스트랩', '패션'],
  ['무선 청소기 스탠드', '가전'],           // 청소기가 스탠드(생활)보다 길다

  // 추측하지 않아야 하는 것 — 근거가 없으면 셀러가 고른다
  ['신제품', null],
  ['A-1', null],
  ['', null],
];

let pass = 0;
const fails: string[] = [];
for (const [name, want] of CASES) {
  const got = guessCategory(name);
  const ok = got === want;
  if (ok) pass++;
  else fails.push(`  ✗ "${name}"  기대 ${want ?? '(없음)'} → 실제 ${got ?? '(없음)'}`);
  console.log(`${ok ? '✓' : '✗'} ${(got ?? '-').padEnd(5)} ← ${name}`);
}

console.log(`\n${pass}/${CASES.length} 통과`);
if (fails.length) { console.log(fails.join('\n')); process.exit(1); }
